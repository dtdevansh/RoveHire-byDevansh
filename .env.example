PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=https://rove-hire.vercel.app

# Supabase
SUPABASE_URL=
SUPABASE_SECRET_KEY=            # sb_secret_… (or legacy service_role); DB access, bypasses RLS
SUPABASE_JWKS_URL=             # <SUPABASE_URL>/auth/v1/.well-known/jwks.json

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rove-hire
R2_ENDPOINT=                    # https://<accountid>.r2.cloudflarestorage.com

# App
MAGIC_LINK_TTL_DAYS=14
SIGNED_URL_TTL_SECONDS=300      # 5 min download links
MAX_RESUME_MB=10
