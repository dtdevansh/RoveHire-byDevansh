PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000    # comma-separated allowlist; first entry is used for apply links

# Supabase
SUPABASE_URL=
SUPABASE_SECRET_KEY=            # sb_secret_… (or legacy service_role); DB access, bypasses RLS
SUPABASE_JWKS_URL=             # <SUPABASE_URL>/auth/v1/.well-known/jwks.json

# Supabase Storage
SUPABASE_STORAGE_BUCKET=rove-hire

# App
MAGIC_LINK_TTL_DAYS=14
SIGNED_URL_TTL_SECONDS=300      # 5 min download links
MAX_RESUME_MB=10
